<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25094" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25094"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="SWGridPanelController">
            <connections>
                <outlet property="gridColorWell" destination="32" id="35"/>
                <outlet property="gridSpacingSlider" destination="10" id="25"/>
                <outlet property="gridView" destination="7" id="9"/>
                <outlet property="showsGridCheckbox" destination="34" id="36"/>
                <outlet property="window" destination="5" id="38"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Grid Settings" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" hidesOnDeactivate="YES" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="5" userLabel="Panel" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" utility="YES" nonactivatingPanel="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" rightStrut="YES" topStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="32" y="408" width="277" height="305"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1728" height="1084"/>
            <value key="minSize" type="size" width="78" height="8"/>
            <view key="contentView" id="6">
                <rect key="frame" x="0.0" y="0.0" width="277" height="305"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="7" customClass="SWGridView">
                        <rect key="frame" x="12" y="138" width="253" height="155"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <connections>
                            <outlet property="controller" destination="-2" id="31"/>
                        </connections>
                    </customView>
                    <box fixedFrame="YES" title="Spacing" translatesAutoresizingMaskIntoConstraints="NO" id="16">
                        <rect key="frame" x="12" y="74" width="253" height="62"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="dcG-e3-VGa">
                            <rect key="frame" x="0.0" y="0.0" width="253" height="48"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <slider verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="10">
                                    <rect key="frame" x="8" y="12" width="234" height="25"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <sliderCell key="cell" continuous="YES" alignment="left" minValue="1" maxValue="20" doubleValue="8" tickMarkPosition="below" numberOfTickMarks="20" allowsTickMarkValuesOnly="YES" sliderType="linear" id="43">
                                        <font key="font" metaFont="system"/>
                                    </sliderCell>
                                    <connections>
                                        <action selector="gridSpacingSliderAction:" target="-2" id="26"/>
                                    </connections>
                                </slider>
                            </subviews>
                        </view>
                        <font key="titleFont" metaFont="system"/>
                    </box>
                    <box fixedFrame="YES" title="Title" titlePosition="noTitle" translatesAutoresizingMaskIntoConstraints="NO" id="18">
                        <rect key="frame" x="12" y="6" width="253" height="69"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="4YQ-Uv-HUW">
                            <rect key="frame" x="0.0" y="0.0" width="253" height="69"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        </view>
                        <font key="titleFont" metaFont="system"/>
                    </box>
                    <colorWell fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="32">
                        <rect key="frame" x="186" y="26" width="53" height="30"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="color" white="1" alpha="1" colorSpace="calibratedWhite"/>
                        <connections>
                            <action selector="gridColorWellAction:" target="-2" id="39"/>
                        </connections>
                    </colorWell>
                    <textField focusRingType="none" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" preferredMaxLayoutWidth="42" translatesAutoresizingMaskIntoConstraints="NO" id="33">
                        <rect key="frame" x="135" y="33" width="46" height="16"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <textFieldCell key="cell" sendsActionOnEndEditing="YES" alignment="left" title="Color:" id="44">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <button imageHugsTitle="YES" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="34">
                        <rect key="frame" x="27" y="32" width="86" height="18"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <buttonCell key="cell" type="check" title="Show Grid" imagePosition="leading" alignment="left" inset="2" id="45">
                            <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="showsGridCheckboxAction:" target="-2" id="37"/>
                        </connections>
                    </button>
                </subviews>
            </view>
            <connections>
                <outlet property="delegate" destination="-2" id="30"/>
            </connections>
            <point key="canvasLocation" x="139" y="146"/>
        </window>
    </objects>
</document>
